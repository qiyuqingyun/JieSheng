{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JieSheng Sidecar",
  "version": "0.1.0",
  "identifier": "com.jiesheng.app",
  "build": {
    "beforeDevCommand": "cd ..\\frontend && yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File D:\\jieshenaiwriting\\JieSheng\\scripts\\build-all.ps1",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "JieSheng",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../target/ai-worker-resources/ai_worker",
      "../target/ai-worker-resources/python"
    ],
    "icon": [
      "icons/favicon.ico"
    ]
  }
}
